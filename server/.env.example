# Copy to .env and fill in. Never commit the real .env file.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/codeshare
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-please
# Exact origin of the frontend (no trailing slash)
CLIENT_URL=http://localhost:5173
# lax = same-site (dev, or frontend+API on same domain). none = frontend and API on different domains (needs HTTPS)
COOKIE_SAMESITE=lax
# leave empty to auto-enable in production; set false for plain-http docker-compose
COOKIE_SECURE=
# Anonymous rooms are deleted after this many days of inactivity
ANONYMOUS_ROOM_TTL_DAYS=30
